# ===== Copy this file to ".env" (same folder as package.json) and fill in YOUR values. Never commit ".env". =====

# Server
PORT=3000
NODE_ENV=development

# Supabase (Dashboard > Project Settings > API). The anon/publishable key is public by design; RLS protects data.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NOTE: the service-role/secret key is NOT used by this app and must not be put here or in any frontend file.

# Google Gemini (backend only). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# A model your key can use (see https://ai.google.dev/gemini-api/docs/models and AI Studio). Not hardcoded on purpose.
GEMINI_MODEL=your-gemini-model-name

# Optional tuning (defaults shown)
MAX_BODY_KB=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CHAT_RATE_LIMIT_MAX=10
PRD_RATE_LIMIT_MAX=5
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=1500
MAX_MESSAGES_PER_PROJECT=500
HISTORY_CHAR_BUDGET=24000
PRD_MAX_OUTPUT_TOKENS=8000
PRD_TIMEOUT_MS=120000
PRD_TRANSCRIPT_CHAR_BUDGET=60000
